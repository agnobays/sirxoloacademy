# Apache configuration for SIR XOLO ACADEMY Announcement Holding Page
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/early-access directly to PHP handler
  RewriteRule ^api/early-access/?$ api.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
